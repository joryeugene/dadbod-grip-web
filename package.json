{
	"name": "dadbod-grip-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"keymaps:check": "node scripts/keymaps.mjs check",
		"keymaps:sync": "node scripts/keymaps.mjs sync",
		"check": "npm run keymaps:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"mdsvex": "^0.12.8",
		"rehype-slug": "^6.0.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.0",
		"vite": "^8.3.5",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.0.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
